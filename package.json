{
  "name": "fresh-orbit",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev --filter=@fresh/playground",
    "generate:api": "pnpm --filter @fresh/api-client generate",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,js,mjs,json,css}\" \"*.{json,js,yaml}\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,tsx,js,mjs,json,css}\" \"*.{json,js,yaml}\""
  },
  "devDependencies": {
    "@fresh/config": "workspace:*",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
