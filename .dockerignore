# Docker build context is the repository root (infra/docker/*.Dockerfile). Keep it small and secret-free.
.git
.github
.claude
.vscode
.idea
**/.DS_Store
**/*.log

# Secrets and local configuration
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
!**/.env.prod.example

# Build outputs and caches (rebuilt inside the image)
**/bin
**/obj
**/node_modules
**/.next
**/dist
**/.turbo
**/coverage
**/TestResults

# Not needed by any image
docs
backend/tests
infra/compose
infra/scripts
infra/monitoring
apps/mobile
packages/flutter
