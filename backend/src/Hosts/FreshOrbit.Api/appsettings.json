{
  "ConnectionStrings": {
    "FreshOrbit": ""
  },
  "Jwt": {
    "Issuer": "freshorbit",
    "Audience": "freshorbit",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownNetworks": []
  },
  "RateLimiting": {
    "OtpRequest": { "PermitLimit": 20, "WindowSeconds": 3600 },
    "OtpVerify": { "PermitLimit": 30, "WindowSeconds": 600 },
    "Login": { "PermitLimit": 10, "WindowSeconds": 300 },
    "Refresh": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Checkout": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Search": { "PermitLimit": 60, "WindowSeconds": 60 },
    "Public": { "PermitLimit": 120, "WindowSeconds": 60 },
    "Coupon": { "PermitLimit": 10, "WindowSeconds": 600 }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
