{
  "Hosting": {
    "RunBackgroundJobsInApi": true
  },
  "Hangfire": {
    "WorkerCount": 2
  },
  "Outbox": {
    "BatchSize": 50,
    "MaxAttempts": 15,
    "PollInterval": "00:00:05",
    "RetryBaseDelay": "00:00:10",
    "RetryMaxDelay": "01:00:00"
  },
  "Notifications": {
    "Sms": { "Provider": "DEVELOPMENT" }
  },
  "Identity": {
    "OtpPerIpPerHour": 500,
    "StaffLoginFailuresPerEmailIp": 20
  },
  "RateLimiting": {
    "OtpRequest": { "PermitLimit": 500, "WindowSeconds": 3600 },
    "OtpVerify": { "PermitLimit": 500, "WindowSeconds": 600 },
    "Login": { "PermitLimit": 100, "WindowSeconds": 300 },
    "Refresh": { "PermitLimit": 300, "WindowSeconds": 60 },
    "Checkout": { "PermitLimit": 100, "WindowSeconds": 60 },
    "Search": { "PermitLimit": 600, "WindowSeconds": 60 },
    "Public": { "PermitLimit": 1200, "WindowSeconds": 60 },
    "Coupon": { "PermitLimit": 100, "WindowSeconds": 600 }
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Hangfire": "Warning"
      }
    }
  }
}
