  <ItemGroup>
    <Compile Include="..\Identity.Tests\Support\*.cs" LinkBase="Support" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\FreshOrbit.Testing\FreshOrbit.Testing.csproj" />
  </ItemGroup>
