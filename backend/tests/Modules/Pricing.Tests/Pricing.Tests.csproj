<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FreshOrbit.Pricing.Tests</RootNamespace>
    <AssemblyName>FreshOrbit.Pricing.Tests</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared scenario builder (served location, published product, prices, test stock table). -->
    <Compile Include="..\Catalog.Tests\Support\StorefrontScenario.cs" Link="Support\StorefrontScenario.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\FreshOrbit.Testing\FreshOrbit.Testing.csproj" />
  </ItemGroup>
</Project>
