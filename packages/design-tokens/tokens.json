    "oceanTeal": "#073B4C",
    "seaGreen": "#0E9384",
    "softBackground": "#F4F8F7",
    "warmSand": "#E9AD55"
  },
  "color": {
    "light": {
      "background": "#F4F8F7",
      "surface": "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "muted": "#E7EFED",
      "text": "#0A2630",
      "textMuted": "#4A6470",
      "textInverse": "#FFFFFF",
      "border": "#D4E0DD",
      "borderStrong": "#6F8985",
      "ring": "#0E9384",
      "overlay": "#04161D",
      "primary": "#073B4C",
      "primaryHover": "#0B4F65",
