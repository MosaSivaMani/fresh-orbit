      "accent": "#0B7D70",
      "accentHover": "#096A5F",
      "onAccent": "#FFFFFF",
      "accentSubtle": "#E0F2EF",
      "accentText": "#08665C",
      "highlight": "#E9AD55",
      "highlightHover": "#DE9C3C",
      "onHighlight": "#2E1D05",
      "highlightSubtle": "#FBF0DF",
      "highlightText": "#7A4B0B",
      "success": "#17803D",
      "onSuccess": "#FFFFFF",
      "successSubtle": "#E2F4E8",
      "successText": "#14632F",
      "warning": "#B45309",
      "onWarning": "#FFFFFF",
      "warningSubtle": "#FDF0DC",
      "warningText": "#7C3D07",
      "danger": "#C2362B",
      "onDanger": "#FFFFFF",
      "dangerSubtle": "#FCE8E6",
      "dangerText": "#992218",
      "info": "#1D6FB8",
      "onInfo": "#FFFFFF",
      "infoSubtle": "#E3EEF9",
      "infoText": "#164F82"
    },
    "dark": {
      "background": "#051C24",
      "surface": "#0A2731",
      "surfaceRaised": "#0F313C",
      "muted": "#123843",
      "text": "#E8F1EF",
      "textMuted": "#A0B7B4",
      "textInverse": "#0A2630",
      "border": "#1F4551",
      "borderStrong": "#5F8790",
      "ring": "#3CC2B1",
      "overlay": "#000000",
      "primary": "#5CCFC0",
      "primaryHover": "#7ADAD0",
      "onPrimary": "#042029",
      "accent": "#3CC2B1",
      "accentHover": "#5CCFC0",
      "onAccent": "#042029",
      "accentSubtle": "#0E3B3B",
      "accentText": "#7FDCD0",
      "highlight": "#E9AD55",
      "highlightHover": "#F0BE72",
      "onHighlight": "#2E1D05",
      "highlightSubtle": "#3B2B10",
      "highlightText": "#F3C885",
      "success": "#4CC97C",
      "onSuccess": "#052E16",
      "successSubtle": "#0F3A24",
      "successText": "#8BE3AC",
      "warning": "#F0B356",
      "onWarning": "#2A1A03",
      "warningSubtle": "#3D2A0B",
      "warningText": "#F6CF8E",
      "danger": "#F27466",
      "onDanger": "#2B0703",
      "dangerSubtle": "#431612",
      "dangerText": "#F7A99F",
      "info": "#6AAEF0",
      "onInfo": "#04203B",
      "infoSubtle": "#10304D",
      "infoText": "#A9CFF6"
    }
  },
  "contrast": {
    "$description": "Pairs checked by the unit test. text = WCAG AA normal text (4.5:1); ui = non-text UI component (3:1).",
    "text": [
      ["text", "background"],
      ["text", "surface"],
      ["text", "surfaceRaised"],
      ["text", "muted"],
      ["textMuted", "background"],
      ["textMuted", "surface"],
      ["textMuted", "muted"],
      ["onPrimary", "primary"],
      ["onPrimary", "primaryHover"],
      ["onAccent", "accent"],
      ["onAccent", "accentHover"],
      ["accentText", "accentSubtle"],
      ["accentText", "surface"],
      ["onHighlight", "highlight"],
      ["onHighlight", "highlightHover"],
      ["highlightText", "highlightSubtle"],
      ["onSuccess", "success"],
      ["successText", "successSubtle"],
      ["onWarning", "warning"],
      ["warningText", "warningSubtle"],
      ["onDanger", "danger"],
      ["dangerText", "dangerSubtle"],
      ["dangerText", "surface"],
      ["onInfo", "info"],
      ["infoText", "infoSubtle"],
      ["primary", "surface"],
      ["primary", "background"]
    ],
    "ui": [
      ["borderStrong", "surface"],
      ["borderStrong", "background"],
      ["ring", "surface"],
      ["ring", "background"]
    ]
  },
  "font": {
    "sans": "Inter, \"Noto Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "display": "\"Plus Jakarta Sans\", Inter, ui-sans-serif, system-ui, sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "typeScale": {
    "xs": { "size": 12, "lineHeight": 16 },
    "sm": { "size": 14, "lineHeight": 20 },
    "base": { "size": 16, "lineHeight": 24 },
    "lg": { "size": 18, "lineHeight": 28 },
    "xl": { "size": 20, "lineHeight": 28 },
    "2xl": { "size": 24, "lineHeight": 32 },
    "3xl": { "size": 30, "lineHeight": 36 },
    "4xl": { "size": 36, "lineHeight": 44 },
    "5xl": { "size": 48, "lineHeight": 56 }
  },
  "spacing": {
    "$description": "Pixels. Tailwind's spacing unit is 4px, so `p-4` = spacing.4 = 16px.",
    "0": 0,
    "0.5": 2,
    "1": 4,
    "1.5": 6,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96
  },
  "radius": {
    "sm": 6,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "2xl": 24,
    "full": 9999
  },
  "shadow": {
    "xs": "0 1px 2px 0 rgb(7 59 76 / 0.06)",
    "sm": "0 1px 3px 0 rgb(7 59 76 / 0.08), 0 1px 2px -1px rgb(7 59 76 / 0.08)",
    "md": "0 4px 8px -2px rgb(7 59 76 / 0.10), 0 2px 4px -2px rgb(7 59 76 / 0.06)",
    "lg": "0 12px 24px -6px rgb(7 59 76 / 0.14), 0 4px 8px -4px rgb(7 59 76 / 0.08)",
    "xl": "0 24px 48px -12px rgb(7 59 76 / 0.22)"
  },
  "motion": {
    "duration": { "instant": 0, "fast": 120, "normal": 200, "slow": 320 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },
  "breakpoint": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1536 },
  "zIndex": {
    "dropdown": 1000,
    "sticky": 1100,
    "overlay": 1300,
    "modal": 1400,
    "toast": 1500,
    "tooltip": 1600
  }
}
