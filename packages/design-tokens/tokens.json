  "contrast": {
    "$description": "Pairs checked by the unit test. text = WCAG AA normal text (4.5:1); ui = non-text UI component (3:1).",
    "text": [
      ["text", "background"],
      ["text", "surface"],
      ["text", "surfaceRaised"],
      ["text", "muted"],
      ["textMuted", "background"],
      ["textMuted", "surface"],
      ["textMuted", "muted"],
      ["onPrimary", "primary"],
      ["onPrimary", "primaryHover"],
      ["onAccent", "accent"],
      ["onAccent", "accentHover"],
      ["accentText", "accentSubtle"],
      ["accentText", "surface"],
      ["onHighlight", "highlight"],
      ["onHighlight", "highlightHover"],
      ["highlightText", "highlightSubtle"],
      ["onSuccess", "success"],
      ["successText", "successSubtle"],
      ["onWarning", "warning"],
      ["warningText", "warningSubtle"],
      ["onDanger", "danger"],
      ["dangerText", "dangerSubtle"],
      ["dangerText", "surface"],
      ["onInfo", "info"],
      ["infoText", "infoSubtle"],
      ["primary", "surface"],
      ["primary", "background"],
      ["text", "surfaceSand"],
      ["text", "surfaceSandStrong"],
      ["textMuted", "surfaceSand"],
      ["textMuted", "surfaceSandStrong"],
      ["accentText", "surfaceSand"],
      ["primary", "surfaceSand"],
      ["onAccentCoral", "accentCoral"],
      ["accentCoralText", "surface"],
      ["accentCoralText", "background"],
      ["accentCoralText", "surfaceSand"],
      ["accentCoralText", "accentCoralSubtle"],
      ["accentCoralText", "surfacePaper"],
      ["text", "surfacePaper"],
      ["textMuted", "surfacePaper"],
      ["accentText", "surfacePaper"],
      ["accentText", "tealSoft"],
      ["text", "tealSoft"],
      ["text", "ice"],
      ["onMango", "mango"],
      ["onAccentCoral", "accentCoral"],
      ["onAccent", "accent"],
      ["text", "canvas"],
      ["textMuted", "canvas"],
      ["accentText", "canvas"],
      ["accentCoralText", "canvas"],
      ["primary", "canvas"],
      ["text", "mangoSoft"],
      ["text", "iceSoft"],
      ["textMuted", "tealSoft"],
      ["onOutlineInk", "outlineInk"],
      ["onBlockCoral", "blockCoral"],
      ["onBlockTeal", "blockTeal"],
      ["onBlockMango", "blockMango"],
      ["onBlockIce", "blockIce"]
    ],
    "ui": [
      ["borderStrong", "surface"],
      ["borderStrong", "background"],
      ["ring", "surface"],
      ["ring", "background"]
    ]
  },
  "font": {
    "sans": "Inter, \"Noto Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "display": "\"Baloo 2\", Inter, ui-sans-serif, system-ui, sans-serif",
    "script": "\"Dancing Script\", \"Segoe Script\", cursive",
    "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "typeScale": {
    "xs": {
      "size": 12,
      "lineHeight": 16
    },
    "sm": {
      "size": 14,
      "lineHeight": 20
    },
    "base": {
      "size": 16,
      "lineHeight": 24
    },
    "lg": {
      "size": 18,
      "lineHeight": 28
    },
    "xl": {
      "size": 20,
      "lineHeight": 28
    },
    "2xl": {
      "size": 24,
      "lineHeight": 32
    },
    "3xl": {
      "size": 30,
      "lineHeight": 36
    },
    "4xl": {
      "size": 36,
      "lineHeight": 44
    },
    "5xl": {
      "size": 48,
      "lineHeight": 56
    }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96,
    "$description": "Pixels. Tailwind's spacing unit is 4px, so `p-4` = spacing.4 = 16px.",
    "0.5": 2,
    "1.5": 6
  },
  "radius": {
    "sm": 6,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "2xl": 24,
    "3xl": 32,
    "full": 9999
  },
  "shadow": {
    "$description": "A string applies to both themes (teal tints become black in dark mode); a { light, dark } object sets each theme. soft-* = the warm, wide shadows of the illustrated look (soft-md is the card shadow); sticker = the ink offset shadow under stickers; polaroid = the sand block shadow under polaroid cards.",
    "xs": "0 1px 2px 0 rgb(7 59 76 / 0.06)",
    "sm": "0 1px 3px 0 rgb(7 59 76 / 0.08), 0 1px 2px -1px rgb(7 59 76 / 0.08)",
    "md": "0 4px 8px -2px rgb(7 59 76 / 0.10), 0 2px 4px -2px rgb(7 59 76 / 0.06)",
    "lg": "0 12px 24px -6px rgb(7 59 76 / 0.14), 0 4px 8px -4px rgb(7 59 76 / 0.08)",
    "xl": "0 24px 48px -12px rgb(7 59 76 / 0.22)",
    "soft-sm": {
      "light": "0 1px 2px rgb(60 40 10 / 0.05), 0 4px 12px rgb(60 40 10 / 0.06)",
      "dark": "0 1px 2px rgb(0 0 0 / 0.3), 0 6px 16px rgb(0 0 0 / 0.3)"
    },
    "soft-md": {
      "light": "0 1px 2px rgb(60 40 10 / 0.06), 0 8px 24px rgb(60 40 10 / 0.08)",
      "dark": "0 1px 2px rgb(0 0 0 / 0.3), 0 10px 28px rgb(0 0 0 / 0.35)"
    },
    "soft-lg": {
      "light": "0 2px 4px rgb(60 40 10 / 0.06), 0 18px 44px rgb(60 40 10 / 0.12)",
      "dark": "0 2px 4px rgb(0 0 0 / 0.35), 0 20px 48px rgb(0 0 0 / 0.45)"
    },
    "sticker-sm": {
      "light": "2px 2px 0 0 #14302F",
      "dark": "2px 2px 0 0 #F4EBDD"
    },
    "sticker": {
      "light": "3px 3px 0 0 #14302F",
      "dark": "3px 3px 0 0 #F4EBDD"
    },
    "polaroid": {
      "light": "12px 12px 0 0 #F3E4CC",
      "dark": "12px 12px 0 0 #1C2C2A"
    }
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast": 120,
      "normal": 200,
      "slow": 320
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },
  "breakpoint": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "2xl": 1536
  },
  "zIndex": {
    "dropdown": 1000,
    "sticky": 1100,
    "overlay": 1300,
    "modal": 1400,
    "toast": 1500,
    "tooltip": 1600
  }
}
