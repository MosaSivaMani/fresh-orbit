{
  "name": "@fresh/illustrations",
  "version": "0.0.0",
  "private": true,
  "description": "Fresh Orbit illustration slots (D53): manifest with alt text and generation prompts, our own placeholder SVGs, and the final images once the owner generates them.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest.json": "./manifest.json",
    "./assets/*": "./assets/*"
  },
  "bin": {
    "fresh-illustrations-copy": "./scripts/copy-assets.mjs"
  },
  "files": [
    "dist",
    "assets",
    "manifest.json",
    "scripts/copy-assets.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "import": "node scripts/import.ts",
    "placeholders": "node scripts/placeholders.ts",
    "prompts": "node scripts/prompts.ts",
    "optimize": "node scripts/optimize.ts",
    "validate": "node scripts/validate.ts",
    "sync-mobile": "node scripts/sync-mobile.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fresh/config": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "9.39.5",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
