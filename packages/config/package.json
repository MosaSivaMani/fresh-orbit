{
  "name": "@fresh/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tsconfig bases, ESLint flat presets, Prettier preset and Tailwind v4 preset for Fresh Orbit.",
  "type": "module",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/react-library.json": "./tsconfig/react-library.json",
    "./tsconfig/vite-app.json": "./tsconfig/vite-app.json",
    "./tsconfig/next-app.json": "./tsconfig/next-app.json",
    "./eslint/base": "./eslint/base.js",
    "./eslint/react": "./eslint/react.js",
    "./eslint/next": "./eslint/next.js",
    "./prettier": "./prettier/index.js",
    "./tailwind.css": {
      "style": "./tailwind/preset.css",
      "default": "./tailwind/preset.css"
    }
  },
  "scripts": {
    "lint": "eslint ."
  },
  "dependencies": {
    "@fresh/design-tokens": "workspace:*",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript-eslint": "8.71.1"
  },
  "peerDependencies": {
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
