# Copy to .env.local for development. Every value is required where noted; the site refuses to guess.

# Origin of FreshOrbit.Api (no trailing slash, no /api/v1). Server-side only: the browser talks to this
# site's own /api/v1 proxy, never to the API directly. Required.
FRESH_API_ORIGIN=http://localhost:5080

# Public origin of this website, used for canonical URLs, sitemap and JSON-LD. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
