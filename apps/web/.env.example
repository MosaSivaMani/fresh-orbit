# Copy to .env.local for development. Every value is required where noted; the site refuses to guess.

# Origin of FreshOrbit.Api (no trailing slash, no /api/v1). Server-side only: the browser talks to this
# site's own /api/v1 proxy, never to the API directly. Required.
FRESH_API_ORIGIN=http://localhost:5080

# Public origin of this website, used for canonical URLs, sitemap and JSON-LD. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store pages of the customer app, shown in the "get the app" band. Optional: an unset one is not shown.
# FRESH_PLAY_STORE_URL=
# FRESH_APP_STORE_URL=

# "true" only on the free public demo (render.yaml): shows the "Demo: test data only" banner on every page.
# Inlined at build time. Leave unset everywhere else.
# NEXT_PUBLIC_DEMO_MODE=

# Deployment environment, the same value the API runs with (Staging, Production, ...). Only "Production", in a
# production build with NEXT_PUBLIC_SITE_URL set, lets search engines index the site; anything else, or unset, is
# noindex (L-45, D301). Leave unset in development.
# APP_ENVIRONMENT=

# The grievance officer shown on /support and linked from the footer (L-7, D300). Shown only when name, e-mail and
# response time are all set; the designation is optional. The business profile has no such fields yet.
# FRESH_GRIEVANCE_OFFICER_NAME=
# FRESH_GRIEVANCE_OFFICER_DESIGNATION=Grievance Officer
# FRESH_GRIEVANCE_OFFICER_EMAIL=
# FRESH_GRIEVANCE_RESPONSE_TIME=Acknowledged within 48 hours, resolved within one month
