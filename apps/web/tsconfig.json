{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@fresh/config/tsconfig/next-app.json",
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
    "types": ["vitest/globals", "@testing-library/jest-dom/vitest"]
  },
  "include": [
    "next-env.d.ts",
    "src",
    "test",
    "e2e",
    ".next/types/**/*.ts",
    "next.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", ".next/cache"]
}
