# API origin when the admin is not served from the same origin as the API (no trailing slash).
# Leave empty in development: Vite proxies /api and /media to http://localhost:5080.
VITE_API_ORIGIN=

# "true" only on the free public demo (render.yaml): shows the "Demo: test data only" banner on every screen.
# Inlined at build time. Leave empty everywhere else.
VITE_DEMO_MODE=
