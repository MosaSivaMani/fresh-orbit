# Fresh Orbit edge: HTTPS (Let's Encrypt, automatic), routing, security headers, compression, /media.
#   https://{$DOMAIN}         customer website (web:3000, Next.js)
#   https://admin.{$DOMAIN}   admin dashboard   (admin:8080, static SPA)
#   https://api.{$DOMAIN}     REST API          (api:8080); /media/* served from the file-storage volume (D21)
# Environment (from .env.prod through compose): DOMAIN, ACME_EMAIL, TRUSTED_PROXIES.
# Validate: docker compose ... exec caddy caddy validate --config /etc/caddy/Caddyfile
{
	email {$ACME_EMAIL}
	servers {
		# Real client IP for logs and the API's rate limits. Behind Cloudflare, TRUSTED_PROXIES lists its ranges and
		# CF-Connecting-IP carries the visitor's address.
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
	# The admin API stays on localhost:2019 inside the container (compose healthcheck); it is never published.
}

# X-Forwarded-For carries only the visitor address Caddy determined ({client_ip}: CF-Connecting-IP behind trusted
# Cloudflare, else the TCP peer). The API believes one hop from the edge network, so the header must hold exactly
# that one address, never a client-supplied list (W9, SEC-2). The website's /api/v1 proxy passes it on unchanged.
(client_ip_header) {
	header_up X-Forwarded-For {client_ip}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(self), usb=(), interest-cohort=()"
		-Server
		-X-Powered-By
	}
	log {
		output stdout
		format json
	}
}

# API routes shared by api.{$DOMAIN} (mobile app, public images) and admin.{$DOMAIN} (same-origin admin calls).
(api_routes) {
	# Public product images straight from the volume. Same rule as the Api's UseFreshOrbitMedia: only .webp/.jpg/.png
	# are public (originals and anything else stay private); keys never change content, so cache for a year.
	@publicMedia path_regexp publicMedia (?i)^/media/[^.][^?]*\.(webp|jpg|png)$
	handle @publicMedia {
		uri strip_prefix /media
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		header Cross-Origin-Resource-Policy "cross-origin"
		file_server
	}
	handle /media/* {
		respond 404
	}

	# Uploads. Product image: Catalog accepts up to 5 MB (ImageFormats.MaxBytes) plus multipart overhead.
	# Complaint: up to 4 photos (docs/api); 4 x 5 MB assumed until Ordering states its own limit.
	@imageUpload {
		method POST
		path_regexp ^/api/v1/admin/products/[^/]+/images$
	}
	handle @imageUpload {
		request_body {
			max_size 6MB
		}
		reverse_proxy api:8080 {
			import client_ip_header
		}
	}
	@complaintUpload {
		method POST
		path_regexp ^/api/v1/orders/[^/]+/complaints$
	}
	handle @complaintUpload {
		request_body {
			max_size 21MB
		}
		reverse_proxy api:8080 {
			import client_ip_header
		}
	}

	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8080 {
			import client_ip_header
		}
	}
}

# ---- Customer website (Next.js) --------------------------------------------------------------------------------
{$DOMAIN} {
	import common
	# The browser talks only to this origin: pages, the /api/v1/* proxy and the /bff/auth/* handlers all live in the
	# Next.js server (docs/design/web.md). Next.js App Router injects inline bootstrap scripts, hence 'unsafe-inline'
	# for scripts (a nonce would need Next.js middleware). Product images come from api.{$DOMAIN}/media. Add a payment
	# gateway's origins here when online payments go live (Phase 11).
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.{$DOMAIN}; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

	# Complaint photos pass through the website's /api/v1 proxy.
	@complaintUpload {
		method POST
		path_regexp ^/api/v1/orders/[^/]+/complaints$
	}
	handle @complaintUpload {
		request_body {
			max_size 21MB
		}
		reverse_proxy web:3000 {
			import client_ip_header
		}
	}
	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy web:3000 {
			import client_ip_header
		}
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# ---- Admin dashboard (static SPA; /api and /media go to the API on the same origin) ---------------------------
admin.{$DOMAIN} {
	import common
	# Strict (D40): staff tokens live in sessionStorage, so only this origin's own script files may run. No inline
	# scripts, no third-party origins, no eval, and Trusted Types enforced for DOM script sinks. Styles from files;
	# React/Radix set inline styles through the CSSOM, which CSP does not restrict.
	header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://api.{$DOMAIN}; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; require-trusted-types-for 'script'; upgrade-insecure-requests"
	header X-Robots-Tag "noindex, nofollow"

	import api_routes

	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy admin:8080
	}
}

# ---- API and media (mobile app, image URLs) --------------------------------------------------------------------
api.{$DOMAIN} {
	import common
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"

	import api_routes

	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8080 {
			import client_ip_header
		}
	}
}
