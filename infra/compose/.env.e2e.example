# Throwaway configuration for the LOCAL end-to-end check (docker-compose.prod.yml + docker-compose.e2e.yml).
# infra/scripts/e2e-check.sh copies this to .env.e2e (git-ignored) and replaces every __GENERATED__ with a fresh
# random value. Nothing here is a real secret or a real endpoint; never use this file on a server.

# --- Release: local images only, never the GHCR names ------------------------------------------------------------
IMAGE_REGISTRY=fo-e2e
IMAGE_TAG=local

# --- Environment: the same mode as the live server -----------------------------------------------------------------
APP_ENVIRONMENT=Production
SEED_SAMPLE_DATA=false
LOG_LEVEL=Information

# --- Domain and TLS: Caddy's local CA for localhost, admin.localhost, api.localhost --------------------------------
DOMAIN=localhost
ACME_EMAIL=e2e@example.invalid
TRUSTED_PROXIES=private_ranges
# Host ports Caddy publishes on 127.0.0.1 (docker-compose.e2e.yml).
E2E_HTTP_PORT=18080
E2E_HTTPS_PORT=18443

# --- Docker network: away from Docker's default 172.17-31.x pools and from the production default ------------------
DOCKER_SUBNET=10.231.17.0/24

# --- Database ----------------------------------------------------------------------------------------------------
POSTGRES_DB=freshorbit
POSTGRES_USER=freshorbit
POSTGRES_PASSWORD=__GENERATED__

# --- Authentication ----------------------------------------------------------------------------------------------
JWT_ISSUER=freshorbit
JWT_AUDIENCE=freshorbit
JWT_SIGNING_KEY=__GENERATED__

# --- Business contact --------------------------------------------------------------------------------------------
BUSINESS_NAME=Fresh Orbit E2E
SUPPORT_PHONE=
SUPPORT_EMAIL=

# --- E-mail: empty host = logged, not sent -------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Fresh Orbit

# --- SMS: required by the compose file; .invalid endpoint, never reachable ----------------------------------------
SMS_DLT_BASE_URL=https://dlt.example.invalid
SMS_DLT_API_KEY=__GENERATED__
SMS_DLT_SENDER_ID=FOEETE
SMS_DLT_PRINCIPAL_ENTITY_ID=1000000000000000000

# --- Outbox ------------------------------------------------------------------------------------------------------
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_INTERVAL=00:00:02

# --- Monitoring off ----------------------------------------------------------------------------------------------
COMPOSE_PROFILES=

# --- First admin created by the check (password generated) ---------------------------------------------------------
E2E_ADMIN_EMAIL=admin@e2e.example.invalid
E2E_ADMIN_NAME=E2E Admin
E2E_ADMIN_PASSWORD=__GENERATED__
