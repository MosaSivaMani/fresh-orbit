# Fresh Orbit server configuration for infra/compose/docker-compose.prod.yml.
# Copy to infra/compose/.env.prod on the server (chmod 600, owner deploy). Never commit the real file.
# Generate secrets on the server, e.g.:  openssl rand -hex 32
# Keep values free of spaces, quotes, `;` and `$` (they end up inside a connection string and shell commands).

# --- Release ---------------------------------------------------------------------------------------------------
# Set by deploy.sh on every deploy; this value is only the fallback for manual `docker compose` commands.
IMAGE_TAG=v0.0.0
IMAGE_REGISTRY=ghcr.io/mosasivamani

# --- Environment -----------------------------------------------------------------------------------------------
# Staging on Oracle: Staging (sample data allowed). Production: Production (sample data refused, FileStorage required).
APP_ENVIRONMENT=Staging
# deploy.sh runs `migrations --sample` when true. Refused by the Migrations host in Production.
SEED_SAMPLE_DATA=false
LOG_LEVEL=Information

# --- Domain and TLS (Caddy) --------------------------------------------------------------------------------------
# Web at https://$DOMAIN, admin at https://admin.$DOMAIN, API and /media at https://api.$DOMAIN
DOMAIN=example.in
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=ops@example.in
# Proxies whose X-Forwarded-For Caddy trusts. Behind Cloudflare (orange cloud) list Cloudflare's ranges from
# https://www.cloudflare.com/ips/ separated by spaces, plus private_ranges. DNS-only (grey cloud): private_ranges.
TRUSTED_PROXIES=private_ranges

# --- Docker network ------------------------------------------------------------------------------------------------
# Fixed subnet of the compose "edge" network (Caddy, web, api); the API trusts forwarded headers only from it
# (ForwardedHeaders__KnownNetworks__0). Database, worker and admin sit on other networks. Change only if it clashes
# with another network on the host.
DOCKER_SUBNET=172.30.0.0/24

# --- Database (postgres, api, worker, migrations) ---------------------------------------------------------------
POSTGRES_DB=freshorbit
POSTGRES_USER=freshorbit
# Required. Hex only (openssl rand -hex 24).
POSTGRES_PASSWORD=

# --- Authentication (api) --------------------------------------------------------------------------------------
JWT_ISSUER=freshorbit
JWT_AUDIENCE=freshorbit
# Required, at least 32 characters (openssl rand -hex 32). Also keys OTP hashes: changing it logs everyone out and
# invalidates OTPs in flight.
JWT_SIGNING_KEY=

# --- Business contact shown in messages (api, worker) -----------------------------------------------------------
BUSINESS_NAME=Fresh Orbit
SUPPORT_PHONE=
SUPPORT_EMAIL=

# --- E-mail (api, worker; Grafana alerts reuse it) ---------------------------------------------------------------
# Empty SMTP_HOST = e-mails are logged, not sent. Any SMTP relay works (e.g. Brevo/Zoho free tiers, Amazon SES).
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Fresh Orbit

# --- SMS (DLT adapter; api, worker) ------------------------------------------------------------------------------
# Required outside Development: the hosts refuse to start without them. What to register on the DLT portal and where
# each id comes from: docs/runbooks/security-configuration.md §2. Notifications__Sms__Provider is fixed to DLT in
# docker-compose.prod.yml.
# Provider adapter: FAST2SMS (docs/research/sms-provider-2026-10.md).
SMS_DLT_GATEWAY=FAST2SMS
# Empty = the gateway's documented endpoint (https://www.fast2sms.com/).
SMS_DLT_BASE_URL=
# Secret: the provider's API key. Never commit it.
SMS_DLT_API_KEY=
# DLT-approved header (3 to 6 letters or digits) and the principal entity id (digits) from the DLT portal.
SMS_DLT_SENDER_ID=
SMS_DLT_PRINCIPAL_ENTITY_ID=
SMS_DLT_TIMEOUT_SECONDS=10
# DLT content template id (digits) of each SMS template; the registered text must match ours exactly.
SMS_DLT_TEMPLATE_OTP_LOGIN=
SMS_DLT_TEMPLATE_OTP_VERIFY_PHONE=
SMS_DLT_TEMPLATE_ORDER_CONFIRMED=
SMS_DLT_TEMPLATE_PAYMENT_RECEIVED=
SMS_DLT_TEMPLATE_PAYMENT_FAILED=
SMS_DLT_TEMPLATE_SUBSTITUTION_PROPOSED=
SMS_DLT_TEMPLATE_ORDER_OUT_FOR_DELIVERY=
SMS_DLT_TEMPLATE_ORDER_DELIVERED=
SMS_DLT_TEMPLATE_DELIVERY_FAILED=
SMS_DLT_TEMPLATE_ORDER_CANCELLED=
SMS_DLT_TEMPLATE_REFUND_INITIATED=
SMS_DLT_TEMPLATE_REFUND_SUCCEEDED=
SMS_DLT_TEMPLATE_COMPLAINT_RESOLVED=

# --- Outbox (worker) -----------------------------------------------------------------------------------------------
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_INTERVAL=00:00:05

# --- Monitoring profile (optional) -------------------------------------------------------------------------------
# Set to `monitoring` to run Grafana + Loki + Alloy (~1 GB RAM); empty = off.
COMPOSE_PROFILES=
GRAFANA_ADMIN_USER=admin
# Required when the monitoring profile runs.
GRAFANA_ADMIN_PASSWORD=
# true = Grafana sends alert e-mails through the SMTP settings above, to ALERT_EMAIL.
GRAFANA_SMTP_ENABLED=false
ALERT_EMAIL=

# --- Backups (infra/scripts/backup.sh) ----------------------------------------------------------------------------
BACKUP_DIR=/var/backups/freshorbit
# Local copies kept (days). Offsite retention is set by the bucket lifecycle rule (see docs/runbooks/backup-restore.md).
BACKUP_RETENTION_DAYS=7
# rclone remote and path, e.g. r2:freshorbit-backups/staging or b2:freshorbit-backups/staging. Empty = local only.
# The remote itself is defined in infra/compose/rclone.conf (chmod 600, never committed).
BACKUP_REMOTE=
BACKUP_REMOTE_RETENTION_DAYS=30
# Optional dead-man's switch pinged after each successful backup (e.g. a free healthchecks.io check URL).
BACKUP_PING_URL=
