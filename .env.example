# Fresh Orbit configuration keys. Copy to .env (git-ignored) or set as environment variables.
# .NET reads nested keys with a double underscore (Jwt__SigningKey = Jwt:SigningKey).

# --- Environment -------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development        # Api
DOTNET_ENVIRONMENT=Development            # Worker, Migrations (sample data is refused when Production or unset)

# --- Database (Api, Worker, Migrations) ----------------------------------------
ConnectionStrings__FreshOrbit=Host=localhost;Port=5432;Database=freshorbit;Username=freshorbit;Password=freshorbit_dev

# --- Authentication (Api) ------------------------------------------------------
Jwt__Issuer=freshorbit
Jwt__Audience=freshorbit
Jwt__SigningKey=change-me-to-a-random-secret-of-at-least-32-characters
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# --- CORS (Api) ----------------------------------------------------------------
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173

# --- Rate limits (Api) ---------------------------------------------------------
RateLimiting__Otp__PermitLimit=5
RateLimiting__Otp__WindowSeconds=600
RateLimiting__Login__PermitLimit=10
RateLimiting__Login__WindowSeconds=300
RateLimiting__Checkout__PermitLimit=10
RateLimiting__Checkout__WindowSeconds=60

# --- Outbox dispatcher (Worker) ------------------------------------------------
Outbox__BatchSize=50
Outbox__MaxAttempts=5
Outbox__PollInterval=00:00:05

# --- Seeding (Migrations; default: nearest data/reference and data/sample folders) -
Seeding__ReferenceDataPath=
Seeding__SampleDataPath=

# --- Logging -------------------------------------------------------------------
Serilog__MinimumLevel__Default=Information

# --- Dev compose host ports (infra/compose/docker-compose.dev.yml) -------------
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
